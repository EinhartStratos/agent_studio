{
  "name": "agent-studio-shell",
  "version": "1.0.0",
  "description": "Electron shell for the Pi agent with hot-update content support",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "EinhartStratos",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux:x64": "electron-builder --linux --x64",
    "dist:linux:arm64": "electron-builder --linux --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.26.0",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.0.0",
    "docx": "^9.7.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.0",
    "pptx2json": "^0.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "tar": "^6.2.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typebox": "^1.1.38",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/tar": "^6.1.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.25",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "com.einhartstratos.agent-studio",
    "productName": "Agent Studio",
    "copyright": "Copyright 2026 EinhartStratos",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!*.md",
          "!*.txt"
        ]
      },
      {
        "from": "resources/agent-tools",
        "to": "agent-tools",
        "filter": [
          "**/*",
          "!*.md",
          "!*.txt"
        ]
      },
      {
        "from": "resources/default-content",
        "to": "default-content",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/config",
        "to": "config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/titlebar",
        "to": "titlebar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "EinhartStratos",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    }
  },
  "engines": {
    "node": ">=24.18.1"
  }
}
