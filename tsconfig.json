{
  "include": ["src", "third_party/pi-acp/src"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "out",
    "baseUrl": ".",
    "paths": {
      "pi-acp/*": ["third_party/pi-acp/src/*"],
      "pi-acp": ["third_party/pi-acp/src/lib.ts"]
    }
  }
}
